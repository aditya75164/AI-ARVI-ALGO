# Copy to .env and fill locally. Never commit .env.
KITE_API_KEY=replace_with_your_kite_api_key
KITE_API_SECRET=replace_with_your_kite_api_secret
# Workers require a valid daily Kite access token; renew after expiry.
KITE_ACCESS_TOKEN=replace_with_daily_access_token
ARVI_DB_PATH=/data/arvi_bot.db
ARVI_BOT_CONFIG=/app/bot_config.example.json
ARVI_LIVE_TRADING=NO
ARVI_LIVE_TRADING_APPROVED=NO
ARVI_STOCK_SCAN_SECONDS=900
ARVI_STOCK_MAX_STOCKS=25
LOG_LEVEL=INFO
